@using MudBlazor
@inject NavigationManager Nav

<MudAppBar Color="Color.Dark" Elevation="0" Dense="true">
    <MudText Typo="Typo.h6">eZionBlazor</MudText>
    <MudLink Href="/" Class="ms-3"><MudIcon Icon="@Icons.Material.Filled.Home" Class="me-1" /> Home</MudLink>
    <MudLink Href="/counter" Class="ms-3"><MudIcon Icon="@Icons.Material.Filled.Add" Class="me-1" /> Counter</MudLink>
    <MudLink Href="/fetchdata" Class="ms-3"><MudIcon Icon="@Icons.Material.Filled.List" Class="me-1" /> Fetch data</MudLink>
    <MudMenu Label="Contábil" Class="ms-3" Dense="true" OffsetY>
        <MudMenuItem Disabled="true">Cadastros</MudMenuItem>
        <MudMenuItem OnClick="@(()=> Nav.NavigateTo("/contabil/cadastros/empresa"))">Empresa</MudMenuItem>
        <MudMenuItem OnClick="@(()=> Nav.NavigateTo("/contabil"))">Lançamentos</MudMenuItem>
    </MudMenu>
</MudAppBar>
